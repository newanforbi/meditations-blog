<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {%- set isMeditation = tags and "meditation" in tags -%}
    {%- set isAuthorPage = page.url == site.author.path -%}
    {%- set isHome = page.url == "/" -%}
    {%- set isSearch = page.url == "/search/" -%}
    {%- set pageTitle = title or site.title -%}
    {%- if isHome or isAuthorPage -%}
      {%- set documentTitle = site.author.name ~ " — Daily meditations on the Word of God" -%}
    {%- elif isMeditation or title -%}
      {%- set documentTitle = (title or site.title) ~ " • " ~ site.author.name -%}
    {%- else -%}
      {%- set documentTitle = site.author.name ~ " — Daily meditations on the Word of God" -%}
    {%- endif -%}
    <title>{{ documentTitle }}</title>
    <meta name="description" content="{{ description or excerpt or site.description }}">
    <meta name="author" content="{{ site.author.name }}">
    <meta name="copyright" content="{{ site.author.name }}">
    {%- if site.googleSiteVerification %}
    <meta name="google-site-verification" content="{{ site.googleSiteVerification }}">
    {%- endif %}
    <meta name="robots" content="{% if page.url == '/404.html' or isSearch %}noindex, follow{% else %}index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1{% endif %}">
    <meta name="googlebot" content="{% if page.url == '/404.html' or isSearch %}noindex, follow{% else %}index, follow{% endif %}">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="{{ site.themeColorLight }}">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="{{ site.themeColorDark }}">
    <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
    <link rel="author" href="{{ site.author.path | absoluteUrl(site.url) }}">
    <link rel="alternate" href="{{ '/feed.xml' | absoluteUrl(site.url) }}" title="Meditations by {{ site.author.name }}" type="application/rss+xml">
    <link rel="alternate" href="{{ '/feed.json' | absoluteUrl(site.url) }}" title="Meditations by {{ site.author.name }}" type="application/feed+json">
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/assets/favicon.svg">
    <link rel="preload" href="/assets/fonts/source-serif.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/source-serif-italic.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/css/app.css" as="style">
    <link rel="stylesheet" href="/assets/css/app.css">
    <meta property="og:locale" content="{{ site.locale }}">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:title" content="{{ documentTitle }}">
    <meta property="og:description" content="{{ description or excerpt or site.description }}">
    <meta property="og:type" content="{% if isMeditation %}article{% elif page.url == site.author.path %}profile{% else %}website{% endif %}">
    <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
    <meta property="article:author" content="{{ site.author.name }}">
    {% if isMeditation %}
    <meta property="article:published_time" content="{{ page.date | isoDate }}">
    <meta property="article:modified_time" content="{{ page.date | isoDate }}">
    <meta property="article:section" content="Meditations">
    {%- for tag in tags -%}
      {%- if tag != "meditation" -%}
    <meta property="article:tag" content="{{ tag }}">
      {%- endif -%}
    {%- endfor -%}
    {% endif %}
    {% if page.url == site.author.path %}
    <meta property="profile:first_name" content="{{ site.author.givenName }}">
    <meta property="profile:last_name" content="{{ site.author.familyName }}">
    <meta property="profile:username" content="{{ site.author.name }}">
    {% endif %}
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ documentTitle }}">
    <meta name="twitter:description" content="{{ description or excerpt or site.description }}">
    <script type="application/ld+json">
      {{ {
        page: page,
        title: pageTitle,
        description: description or excerpt or site.description,
        tags: tags,
        scripture: scripture,
        passage: passage,
        citation: citation,
        content: content
      } | buildSchema(site, collections.meditations) | json | safe }}
    </script>
  </head>
  <body>
    <div class="water-scene" aria-hidden="true">
      <div class="water-orb water-orb--1"></div>
      <div class="water-orb water-orb--2"></div>
      <div class="water-orb water-orb--3"></div>
    </div>
    <a class="skip-link button" href="#main-content">Skip to main content</a>
    <div class="main-wrapper">
      {% include "partials/header.njk" %}
      <main id="main-content" tabindex="-1">
        {{ content | safe }}
      </main>
      {% include "partials/footer.njk" %}
    </div>
    {% if extra_js %}
      <script src="{{ extra_js }}" type="module"></script>
    {% endif %}
  </body>
</html>
