<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} • {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ description or excerpt or site.description }}">
    <meta name="author" content="{{ site.author.name }}">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="{{ site.themeColorLight }}">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="{{ site.themeColorDark }}">
    <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
    <link rel="alternate" href="{{ '/feed.xml' | absoluteUrl(site.url) }}" title="Meditations • {{ site.title }}" type="application/rss+xml">
    <link rel="alternate" href="{{ '/feed.json' | absoluteUrl(site.url) }}" title="Meditations • {{ site.title }}" type="application/feed+json">
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/assets/favicon.svg">
    <link rel="preload" href="/assets/css/app.css" as="style">
    <link rel="stylesheet" href="/assets/css/app.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,400..800;1,62..125,400..800&family=IBM+Plex+Mono:wght@500;700&display=swap">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:title" content="{{ title or site.title }}">
    <meta property="og:description" content="{{ description or excerpt or site.description }}">
    <meta property="og:type" content="{% if layout == 'layouts/meditation.njk' %}article{% else %}website{% endif %}">
    <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
    <meta name="twitter:card" content="summary">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "{% if layout == 'layouts/meditation.njk' %}BlogPosting{% else %}WebPage{% endif %}",
        "name": {{ (title or site.title) | json | safe }},
        "headline": {{ (title or site.title) | json | safe }},
        "description": {{ (description or excerpt or site.description) | json | safe }},
        "url": {{ page.url | absoluteUrl(site.url) | json | safe }},
        "author": {
          "@type": "Person",
          "name": {{ site.author.name | json | safe }}
        }
      }
    </script>
  </head>
  <body>
    <a class="skip-link button" href="#main-content">Skip to main content</a>
    <div class="main-wrapper">
      {% include "partials/header.njk" %}
      <main id="main-content" tabindex="-1">
        {{ content | safe }}
      </main>
      {% include "partials/footer.njk" %}
    </div>
    {% if extra_js %}
      <script src="{{ extra_js }}" type="module"></script>
    {% endif %}
  </body>
</html>
