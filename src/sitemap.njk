---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
layout: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- set core = [
    { url: "/", changefreq: "daily", priority: "1.0" },
    { url: site.author.path, changefreq: "daily", priority: "1.0" },
    { url: "/meditations/", changefreq: "daily", priority: "0.9" },
    { url: "/archive/", changefreq: "weekly", priority: "0.7" },
    { url: "/about/", changefreq: "monthly", priority: "0.8" },
    { url: "/tags/", changefreq: "weekly", priority: "0.5" },
    { url: "/search/", changefreq: "monthly", priority: "0.4" },
    { url: "/colophon/", changefreq: "yearly", priority: "0.3" }
  ] -%}
  {%- set latest = collections.meditations[0].date if collections.meditations.length else none -%}
  {%- for item in core %}
  <url>
    <loc>{{ item.url | absoluteUrl(site.url) }}</loc>
    {%- if latest %}<lastmod>{{ latest | isoDate }}</lastmod>{%- endif %}
    <changefreq>{{ item.changefreq }}</changefreq>
    <priority>{{ item.priority }}</priority>
  </url>
  {%- endfor %}
  {%- for post in collections.meditations %}
  <url>
    <loc>{{ post.url | absoluteUrl(site.url) }}</loc>
    <lastmod>{{ post.date | isoDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {%- endfor %}
  {%- for tag in collections.tagList %}
  <url>
    <loc>{{ ("/tags/" + tag.slug + "/") | absoluteUrl(site.url) }}</loc>
    {%- if latest %}<lastmod>{{ latest | isoDate }}</lastmod>{%- endif %}
    <changefreq>weekly</changefreq>
    <priority>0.4</priority>
  </url>
  {%- endfor %}
</urlset>
