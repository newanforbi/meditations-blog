---
layout: layouts/base.njk
permalink: /
eleventyExcludeFromCollections: true
---
{%- set latest = collections.meditations | head(1) -%}
{%- set recent = collections.meditations | head(12) -%}
<div class="default-wrapper">
  <article class="page block-canvas">
    <div class="block-flow">
      <p class="lede">
        Daily meditations on the Word of God, written by
        <a href="{{ site.author.path }}">{{ site.author.name }}</a>.
      </p>
      <p class="lede-follow">
        Each entry is a sitting with Scripture — a verse, a thought, a prayer — kept here so it can be returned to.
      </p>

      {% if latest.length %}
        {%- set item = latest[0] -%}
        <article class="today-leaf">
          <p class="kicker">
            <span>Today’s meditation</span>
            <span aria-hidden="true">·</span>
            <time class="dt-published" datetime="{{ item.date | htmlDateString }}">{{ item.date | readableDate }}</time>
            {% if item.data.passage %}
              <span aria-hidden="true">·</span>
              <span>{{ item.data.passage }}</span>
            {% endif %}
          </p>
          <h2><a href="{{ item.url }}">{{ item.data.title }}</a></h2>
          {% if item.data.scripture %}
            <blockquote class="scripture scripture--compact">
              <p>{{ item.data.scripture }}</p>
              {% if item.data.citation or item.data.passage %}
                <cite>{{ item.data.citation or item.data.passage }}</cite>
              {% endif %}
            </blockquote>
          {% endif %}
          <p class="today-excerpt">{{ item.data.description or item.templateContent | excerpt(220) }}</p>
          <a class="text-link" href="{{ item.url }}">Continue reading</a>
        </article>
      {% else %}
        <p class="empty-state">The first meditation is being prepared. Check back soon.</p>
      {% endif %}

      {% set message = "Subscribe to the daily meditations feed" %}
      {% include "partials/rss-banner.njk" %}

      {% if recent.length %}
        <h2 id="recent" class="section-title">Recent meditations</h2>
        <div class="h-feed">
          {%- for item in recent -%}
            <article class="recent-activity h-entry">
              <aside class="meta">
                <time class="dt-published" datetime="{{ item.date | htmlDateString }}">{{ item.date | readableDate }}</time>
                {% if item.data.passage %}
                  <span aria-hidden="true">·</span>
                  <span>{{ item.data.passage }}</span>
                {% endif %}
              </aside>
              <h3><a href="{{ item.url }}" class="p-name u-url">{{ item.data.title }}</a></h3>
              {% if item.data.tags %}
                <div class="badges">
                  {%- for tag in item.data.tags -%}
                    {%- if tag != "meditation" -%}
                      <a href="/tags/{{ tag | slugify }}/" class="badge p-category">{{ tag }}</a>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {% endif %}
            </article>
          {%- endfor -%}
        </div>
        <p><a class="text-link" href="/meditations/">Browse all meditations</a></p>
      {% endif %}
    </div>
  </article>
</div>
